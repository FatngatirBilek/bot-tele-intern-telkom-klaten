# Telegram Bot Token (from @BotFather)
TELEGRAM_TOKEN=your-telegram-bot-token

# Google Spreadsheet ID (from the spreadsheet URL)
SPREADSHEET_ID=your-spreadsheet-id

# Sheet GID (tab ID, default: 0)
SHEET_GID=0

# Google Service Account credentials as JSON string (optional, alternative to .json file)
# Copy the entire contents of your service account JSON key file here as a single line
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
